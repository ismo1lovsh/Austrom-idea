# Ushbu faylni nusxalab ".env" deb nomlang va kalitlarni yozing.

# Anthropic (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=
# Arzon va tez: claude-haiku-5-5   |   Sifatliroq: claude-sonnet-5-5
CLAUDE_MODEL=claude-haiku-5-5

# VoiceLab — https://voicelab.uz (asosiy ovoz: STT va TTS). Kalit vlk_ bilan boshlanadi
VOICELAB_API_KEY=
# Bo'sh qoldirsangiz, birinchi o'zbekcha ovoz avtomatik tanlanadi.
# Ro'yxatni ko'rish: python tools/test_voicelab.py
VOICELAB_VOICE_ID=
# Rus tili ovozi (ixtiyoriy). Bo'sh bo'lsa VoiceLab'dagi birinchi ruscha ovoz olinadi,
# u ham bo'lmasa telefon brauzerining o'z ruscha ovozi ishlatiladi.
VOICELAB_VOICE_ID_RU=
VOICELAB_MODEL=

# ElevenLabs — ixtiyoriy zaxira (VOICELAB_API_KEY bo'lsa ishlatilmaydi)
ELEVENLABS_API_KEY=
# Voice Library'dan o'zbekcha ovoz tanlang, "ID" ni nusxalang
ELEVEN_VOICE_ID=
ELEVEN_TTS_MODEL=eleven_v3
ELEVEN_STT_MODEL=scribe_v1
ELEVEN_LANG=uzb
